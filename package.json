{
  "name": "pesewa",
  "version": "0.1.0",
  "description": "Typed TypeScript SDK for Ghana payments: Paystack, Moolre, and MTN MoMo behind one interface, with verified webhooks.",
  "keywords": [
    "ghana",
    "mobile-money",
    "momo",
    "paystack",
    "moolre",
    "mtn",
    "telecel",
    "airteltigo",
    "payments",
    "webhooks",
    "typescript"
  ],
  "author": "Gilbert Addai Gyan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WaifaiMT/pesewa.git"
  },
  "homepage": "https://github.com/WaifaiMT/pesewa#readme",
  "bugs": {
    "url": "https://github.com/WaifaiMT/pesewa/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
